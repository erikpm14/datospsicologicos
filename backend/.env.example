# ============================================================
#  PSYCHOLOGY SHORTS AUTOMATION — Variables de Entorno
#  Solo se paga Claude API. Todo lo demás es GRATIS.
# ============================================================

# --- Anthropic (Claude) — ÚNICA API DE PAGO ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- TTS: Microsoft Edge TTS (GRATIS, sin API key) ---
# Voces disponibles en español:
#   es-ES-AlvaroNeural    (hombre, España)
#   es-ES-ElviraNeural    (mujer, España)
#   es-MX-JorgeNeural     (hombre, México)
#   es-MX-DaliaNeural     (mujer, México)
EDGE_TTS_VOICE=es-ES-AlvaroNeural
EDGE_TTS_RATE=+10%        # Velocidad (+10% = ligeramente más rápido)
EDGE_TTS_PITCH=+0Hz       # Tono (0 = natural)

# --- Kokoro TTS (local, open source) ---
KOKORO_ENABLED=true
KOKORO_VOICE=ef_dora
KOKORO_SPEED=1.05
# IMPORTANTE en Windows: usar la ruta absoluta del ejecutable Python
# para evitar fallo DLL init (exit 3221225786) cuando PM2 arranca con PATH reducido
PYTHON_BIN=C:\Users\...\python.exe   # reemplaza con: python3 -c "import sys;print(sys.executable)"
MIN_HOOK_STRENGTH=8

# --- TikTok (gratis con cuenta developer) ---
TIKTOK_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Instagram / Meta (gratis con cuenta business) ---
INSTAGRAM_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INSTAGRAM_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- YouTube (gratis con cuenta Google) ---
YOUTUBE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_REFRESH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Base de datos: SQLite (GRATIS, archivo local) ---
SQLITE_DB_PATH=./data/psychology_shorts.db

# --- Paths ---
OUTPUT_DIR=./output
ASSETS_DIR=./assets
QUEUE_DIR=./queue
FFMPEG_PATH=ffmpeg          # Asegúrate de que ffmpeg esté en PATH

# --- Configuración de publicación ---
PUBLISH_TIMES_CET=10:00,15:00,20:00
VIDEOS_PER_DAY=3
TARGET_DURATION_SECONDS=28

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Zona horaria ---
TZ=Europe/Madrid

# ════════════════════════════════════════
#  GROWTH ENGINE — MÁQUINA AUTÓNOMA
# ════════════════════════════════════════

# Scheduler de GENERACIÓN autónoma
AUTO_GENERATION_ENABLED=true
CONTENT_GENERATION_INTERVAL_HOURS=3
QUEUE_MAX_PENDING=5

# Scheduler de PUBLICACIÓN autónoma
AUTO_PUBLISH_ENABLED=false
PUBLISH_INTERVAL_HOURS=3
MAX_PUBLISH_PER_DAY=5

# Filtros de calidad (0-100)
MIN_VIRALITY_SCORE_TO_QUEUE=55
MIN_FORMAT_MATCH_SCORE_TO_QUEUE=70
MIN_RETENTION_SCORE_TO_QUEUE=55
MIN_VIRALITY_SCORE_TO_PUBLISH=70
MIN_HOOK_STRENGTH=8            # hookStrength mínimo (0-35). Rechaza hooks planos.

# Formato viral objetivo (20-30s = máxima retención)
FORMAT_TARGET_MIN_SECONDS=20
FORMAT_TARGET_MAX_SECONDS=30

# Winning streak system
STREAK_SCORE_THRESHOLD=72
STREAK_VARIATIONS=3
STREAK_EXPIRY_HOURS=72

# ════════════════════════════════════════
#  A/B TESTING REAL (OBJETIVO 1)
# ════════════════════════════════════════

# Publicar múltiples variantes por experimento (true = 2 vídeos por ciclo)
AB_PUBLISH_VARIANTS=true

# Spacing mínimo entre variante A y B en horas
AB_VARIANT_SPACING_HOURS=2

# ════════════════════════════════════════
#  ESTRATEGIA DE PUBLICACIÓN (OBJETIVO 5)
# ════════════════════════════════════════

# Fase de crecimiento: initial (2-3/día) | growth (3-4/día) | scale (5-6/día)
GROWTH_PHASE=initial

# Horarios de publicación España (Europe/Madrid) — pico de audiencia
# TikTok peak: 13:00-15:00, 19:00-22:30
# YouTube Shorts peak: 14:00-17:00, 20:00-23:00
# Combinado óptimo:
PUBLISH_TIMES_CET=09:00,13:00,15:30,19:00,21:00

# ════════════════════════════════════════
#  CLASIFICACIÓN DE VÍDEOS (OBJETIVO 6)
# ════════════════════════════════════════

# Umbrales para WINNER
WINNER_VIEWS=10000
WINNER_ALT_VIEWS=1000
WINNER_ALT_ENG=0.05

# Umbrales para MEDIO
MEDIO_VIEWS=500
MEDIO_ALT_VIEWS=100
MEDIO_ALT_ENG=0.02

# ════════════════════════════════════════
#  DETECCIÓN TEMPRANA A/B (OBJETIVO 2)
# ════════════════════════════════════════

# Vistas mínimas para evaluar ganador temprano
EARLY_WIN_MIN_VIEWS=200
# Horas mínimas desde publicación
EARLY_WIN_MIN_HOURS=1
# Multiplicador para declarar ganador (earlyScore variante A >= X * earlyScore B)
EARLY_WIN_MULTIPLIER=1.3

# ════════════════════════════════════════
#  RENDER ENGINE CONFIGURATION
# ════════════════════════════════════════

# Motor de renderizado principal
# current = FFmpeg clásico con Pexels (motor actual, siempre disponible)
# shorts = shorts-renderer mejorado (nuevo motor — FASE 2)
# video_use = video-use Python (alternativo — requiere integrations/video-use clonado)
VIDEO_RENDER_ENGINE=current

# Validación manual ANTES de publicación
# true = bloquea toda publicación automática, vídeos requieren aprobación manual
# false = flujo normal, publicación automática según scheduler
VIDEO_RENDER_VALIDATE_BEFORE_PUBLISH=false

# Target LUFS para normalización de audio
# -14 LUFS: estándar TikTok/YouTube Shorts/Instagram (recomendado)
# -16 LUFS: legacy (anterior standard)
AUDIO_LUFS_TARGET=-14

# ════════════════════════════════════════
#  VIDEO-USE CONFIGURATION (opcional, para motor video_use)
# ════════════════════════════════════════

# Activar video-use (solo si VIDEO_RENDER_ENGINE=video_use)
VIDEO_USE_ENABLED=false

# Modo dry-run: true = genera vídeos locales sin publicar
VIDEO_USE_DRY_RUN=true

# Directorio de salida para vídeos video-use
VIDEO_USE_OUTPUT_DIR=./output/video-use

# Estilo visual del skill
VIDEO_USE_STYLE=viral_psychology_short

# Path a video-use
VIDEO_USE_REPO_PATH=./integrations/video-use

# ElevenLabs API key (opcional)
ELEVENLABS_API_KEY=

# Python executable
PYTHON_BIN_VIDEO_USE=python3
